{
  "type": "record",
  "name": "PostApprovalResult",
  "namespace": "com.eefood.common.avro",
  "fields": [
    { "name": "postId", "type": "long" },
    { "name": "recipeId", "type": "long" },
    { "name": "userId", "type": "long" },

    { "name": "status", "type": "string" },
    { "name": "summary", "type": ["null", "string"], "default": null },
    { "name": "totalScore", "type": ["null", "double"], "default": null },

    { "name": "recipeCompleteness", "type": ["null", "int"], "default": null },
    { "name": "ingredientSafety", "type": ["null", "int"], "default": null },
    { "name": "stepClarity", "type": ["null", "int"], "default": null },
    { "name": "contentAppropriate", "type": ["null", "int"], "default": null },
    { "name": "contentRelevance", "type": ["null", "int"], "default": null },
    { "name": "mediaQuality", "type": ["null", "int"], "default": null },

    { "name": "completenessNote", "type": ["null", "string"], "default": null },
    { "name": "safetyNote", "type": ["null", "string"], "default": null },
    { "name": "clarityNote", "type": ["null", "string"], "default": null },
    { "name": "appropriatenessNote", "type": ["null", "string"], "default": null },
    { "name": "relevanceNote", "type": ["null", "string"], "default": null },
    { "name": "mediaQualityNote", "type": ["null", "string"], "default": null },

    { "name": "processedAt", "type": "long" },

    { "name": "recipeTitle", "type": ["null", "string"], "default": null },
    { "name": "recipeImageUrl", "type": ["null", "string"], "default": null }
  ]
}
